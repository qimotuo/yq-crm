# PostgreSQL（./db.sh up）
POSTGRES_USER=yqcrm
POSTGRES_PASSWORD=yqcrm
POSTGRES_DB=yq_crm
POSTGRES_PORT=5432

# 应用端口（./app.sh deploy）
WEB_HTTP_PORT=127.0.0.1:5173
API_PORT=127.0.0.1:5172

# 外部 nginx 路径（./nginx.sh up）
NGINX_CONF_DIR=/data/apps/nginx/conf
NGINX_HTML_DIR=/data/apps/nginx/html
NGINX_LOG_DIR=/data/apps/nginx/logs
NGINX_CERT_DIR=/data/apps/nginx/certs

JWT_SECRET_KEY=change-me-in-production
DEBUG=false

# 微信小程序
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MOCK=true

# 阿里云短信（后续接入）
ALIYUN_SMS_ENABLED=false
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_FINANCE=
ALIYUN_SMS_TEMPLATE_CONTRACT=
ALIYUN_SMS_TEMPLATE_STOCK=

# 宿主机上传目录，放在项目外，发版不会被清掉
HOST_UPLOAD_DIR=/data/yq-crm/uploads
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_MB=10
FINANCE_DUE_DAYS=3
CONTRACT_EXPIRE_DAYS=30
STOCK_LOW_THRESHOLD=5
