# 复制为 .env：cp .env.example .env

# 外部 PostgreSQL（必填）
# 数据库在本机: host.docker.internal
# 数据库在别的容器: 填容器名或内网 IP，如 postgresql://user:pass@10.0.0.5:5432/yq_crm
DATABASE_URL=postgresql://yqcrm:yqcrm@host.docker.internal:5432/yq_crm

WEB_PORT=8080

JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=10080
DEBUG=false

# 仅 ./start.sh full 本地全套时需要：
# POSTGRES_USER=yqcrm
# POSTGRES_PASSWORD=yqcrm
# POSTGRES_DB=yq_crm
# POSTGRES_PORT=5432
